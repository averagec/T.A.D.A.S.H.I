# =============================================================================
# JARVIS Configuration
# Copy this to .env and fill in your values
# =============================================================================

# --- Required ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Model ---
JARVIS_MODEL=claude-sonnet-4-6
JARVIS_MODEL_LIGHT=claude-haiku-4-5-20251001
JARVIS_MAX_TOKENS=4096

# --- Persona ---
JARVIS_NAME=Jarvis
JARVIS_WAKE_WORD=jarvis

# --- Memory ---
JARVIS_DB_PATH=data/jarvis.db

# --- Voice (Phase 2) ---
JARVIS_STT_MODEL=base.en
JARVIS_TTS_VOICE=en_US-ryan-medium
ELEVENLABS_API_KEY=

# --- Tool API Keys (Phase 4) ---
OPENWEATHER_API_KEY=
GOOGLE_CALENDAR_CREDENTIALS=
BRAVE_SEARCH_API_KEY=
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
